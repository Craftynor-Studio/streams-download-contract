{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://craftynor-studio.github.io/streams-download-contract/v1/schema.json",
  "title": "Streams Download Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "metadata", "streams", "operations", "output"],
  "properties": {
    "format": { "const": "streams-download" },
    "version": { "const": 1 },
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "artist": { "type": "string", "maxLength": 200 },
        "sourceUrl": { "$ref": "#/$defs/https" },
        "thumbnailUrl": { "$ref": "#/$defs/https" },
        "durationMs": { "type": "integer", "minimum": 0, "maximum": 31536000000 }
      }
    },
    "streams": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "url", "role", "mimeType"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "url": { "$ref": "#/$defs/https" },
          "role": { "enum": ["video", "audio", "combined", "file"] },
          "mimeType": { "$ref": "#/$defs/mime" },
          "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "expiresAt": { "type": "integer", "minimum": 1, "description": "Unix time in seconds." },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "headers": { "type": "object", "maxProperties": 32, "additionalProperties": { "type": "string", "maxLength": 4096 } }
        }
      }
    },
    "operations": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "type", "inputs"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "type": { "enum": ["mux", "merge"] },
          "inputs": { "type": "array", "minItems": 2, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
          "container": { "enum": ["mp4", "webm"] },
          "mode": { "enum": ["bytes", "media"] }
        },
        "allOf": [
          { "if": { "properties": { "type": { "const": "mux" } } }, "then": { "required": ["container"], "properties": { "container": { "enum": ["mp4", "webm"] }, "inputs": { "type": "array", "maxItems": 2 }, "mode": false } } },
          { "if": { "properties": { "type": { "const": "merge" } } }, "then": { "required": ["mode"], "properties": { "mode": { "enum": ["bytes", "media"] } } } },
          { "if": { "required": ["mode"], "properties": { "mode": { "const": "media" } } }, "then": { "required": ["container"], "properties": { "container": { "enum": ["mp4", "webm"] } } } }
        ]
      }
    },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "filename", "mimeType"],
      "properties": {
        "source": { "$ref": "#/$defs/id" },
        "filename": { "type": "string", "minLength": 1, "maxLength": 180, "pattern": "^[^/\\\\\u0000-\u001f]+$" },
        "mimeType": { "$ref": "#/$defs/mime" }
      }
    },
    "page": { "$ref": "#/$defs/https", "description": "The website page that created this manifest, with the same choices." },
    "refresh": {
      "type": "object", "additionalProperties": false,
      "required": ["url"],
      "properties": { "url": { "$ref": "#/$defs/https" }, "headers": { "type": "object", "maxProperties": 32, "additionalProperties": { "type": "string", "maxLength": 4096 } } }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "https": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 16384 },
    "mime": { "type": "string", "pattern": "^[a-zA-Z0-9!#$&^_.+-]+/[a-zA-Z0-9!#$&^_.+-]+$", "maxLength": 100 }
  }
}
